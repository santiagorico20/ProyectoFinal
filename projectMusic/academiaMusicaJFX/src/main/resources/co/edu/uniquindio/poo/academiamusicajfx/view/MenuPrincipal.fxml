<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.uniquindio.poo.academiamusicajfx.viewController.MenuPrincipalController"
            style="-fx-background-color: white;">

    <top>
        <ToolBar style="-fx-background-color: #A5D6A7;">

            <Label fx:id="lblUsuario"
                   style="-fx-font-size: 16px; -fx-text-fill: #1B5E20;" />

            <Pane HBox.hgrow="ALWAYS"/>

            <Button fx:id="btnCerrarSesion"
                    text="Cerrar Sesión"
                    onAction="#cerrarSesion"
                    style="-fx-background-color: #2E7D32; -fx-text-fill: white;" />

        </ToolBar>
    </top>

    <center>
        <VBox fx:id="menuContainer"
              alignment="CENTER"
              spacing="20">

            <padding>
                <Insets top="30" right="30" bottom="30" left="30"/>
            </padding>

        </VBox>
    </center>
</BorderPane>